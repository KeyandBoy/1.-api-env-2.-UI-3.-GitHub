<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
         http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>


    <!--
        Spring Boot 父工程。

        当前电脑使用 Java 8，
        所以继续使用兼容 Java 8 的
        Spring Boot 2.7.18。
    -->
    <parent>

        <groupId>
            org.springframework.boot
        </groupId>

        <artifactId>
            spring-boot-starter-parent
        </artifactId>

        <version>
            2.7.18
        </version>

        <relativePath/>

    </parent>


    <!-- 项目信息 -->
    <groupId>
        com.example
    </groupId>

    <artifactId>
        insulin-pump-simulation
    </artifactId>

    <version>
        1.0.0
    </version>

    <name>
        insulin-pump-simulation
    </name>

    <description>
        Intelligent Medical Instrument / Insulin Pump Simulation System
    </description>


    <!-- Java 版本 -->
    <properties>

        <java.version>
            1.8
        </java.version>

    </properties>


    <dependencies>

        <!-- 单元测试依赖，保持与 Spring Boot 2.7.18 兼容。 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>


        <!--
            Spring Boot Web

            用于：
            Controller
            REST API
            Tomcat
            Web 页面
        -->
        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-web
            </artifactId>

        </dependency>


        <!--
            Spring Data JPA

            用于将 Java 对象
            保存到数据库中。
        -->
        <dependency>

            <groupId>
                org.springframework.boot
            </groupId>

            <artifactId>
                spring-boot-starter-data-jpa
            </artifactId>

        </dependency>


        <!--
            H2 本地数据库。

            不需要安装 MySQL，
            Spring Boot 可以直接使用。

            后面数据库会以文件形式
            保存到项目目录。
        -->
        <dependency>

            <groupId>
                com.h2database
            </groupId>

            <artifactId>
                h2
            </artifactId>

            <scope>
                runtime
            </scope>

        </dependency>


    </dependencies>


    <build>

        <plugins>


            <!--
                Spring Boot Maven 插件。

                可以使用：
                mvn spring-boot:run
                启动系统。
            -->
            <plugin>

                <groupId>
                    org.springframework.boot
                </groupId>

                <artifactId>
                    spring-boot-maven-plugin
                </artifactId>

            </plugin>


        </plugins>

    </build>


</project>
